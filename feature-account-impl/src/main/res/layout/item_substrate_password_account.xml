<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_primary_list_item"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="@dimen/x2"
    android:paddingEnd="@dimen/x1_5"
    android:paddingBottom="@dimen/x2">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_marginEnd="@dimen/x1_2"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/substratePasswordAccountTitle"
            style="@style/TextAppearance.Soramitsu.Body0"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:textColor="@color/white"
            tools:text="All Fearless apps" />

        <TextView
            android:id="@+id/substratePasswordAccountAddress"
            style="@style/TextAppearance.Soramitsu.Body2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="monospace"
            android:textColor="@color/gray2"
            tools:text="5Gc9xDHeTWMPt44i7b9ty7sdD6cF3EMj4aKeNW7eK3tchiRB" />
    </LinearLayout>

    <ImageView
        android:id="@+id/substratePasswordAccountSelected"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:src="@drawable/ic_checkmark_white_24"
        tools:ignore="ContentDescription" />

</LinearLayout>
