    {
      "id": "non-boolean-values-diverge-and-are-forbidden",
      "note": "Gson reads the string \"false\" as a veto, iOS rejects the document (state unchanged) and the extension ignores non-booleans. The template validator therefore requires JSON booleans.",
      "steps": [
        {
          "fetch": {
            "mobile": {
              "pendulum_case_enabled": false,
              "nft_enabled": false,
              "dapp_enabled": false,
              "polkaswap_mutations_enabled": "false"
            },
            "web": {
              "fiat": {
                "soraCard": false,
                "moonpay": true,
                "ramp": true
              },
              "actions": {
                "polkaswap": "false"
              }
            }
          }
        }
