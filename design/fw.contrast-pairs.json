  "constraints": {
    "auroraMaximumAlpha": {
      "magenta": 0.18,
      "cyan": 0.12,
      "violet": 0.16
    },
    "whiteDitherMaximumAlpha": 0.02,
    "selectedState": "Labels require a check glyph or filled icon; hue alone is insufficient.",
    "statusState": "Status glyph and word are mandatory; coloured status titles are forbidden on banners.",
    "focus": "Cyan ring always has a 2px bgBase offset.",
    "blur": "Glass/elevated recipes assume the page aurora backdrop only. Over arbitrary scrolling content use chrome recipes, which include pure white at zero blur.",
    "decorative": "strokeStrong, divider, hudTrace and glow are never the sole interactive boundary; text on glow is forbidden.",
    "priceState": "Price uses direction glyph and explicit sign; it does not share a component with info or success.",
    "highContrast": "High-contrast numeric passes do not relax placement restrictions."
  },
  "limits": [
    "Mathematical token contract; actual pixels, glyphs, screen placement and assistive technology require native/browser qualification.",
    "No production UI rollout or full per-repository gate is implied by the shared checker alone."
  ]
