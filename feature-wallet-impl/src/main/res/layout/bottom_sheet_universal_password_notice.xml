<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/gray4"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/universalPasswordTitle"
            style="@style/TextAppearance.Soramitsu.Header3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/universal_password_notice_title"
            android:textColor="@color/white"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/universalPasswordMessage"
            style="@style/TextAppearance.Soramitsu.Body1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/universal_password_notice_message"
            android:textColor="@color/white_64" />

        <LinearLayout
            android:id="@+id/universalPasswordRows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />

        <jp.co.soramitsu.common.view.PrimaryButton
            android:id="@+id/universalPasswordSwitch"
            style="@style/Widget.Fearless.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/universal_password_notice_switch" />

        <Button
            android:id="@+id/universalPasswordLater"
            style="@style/Widget.Fearless.Button.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/universal_password_notice_later"
            tools:ignore="ButtonStyle" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
