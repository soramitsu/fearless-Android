    <string name="pin_recovery_title">恢复钱包 PIN</string>
    <string name="pin_recovery_intro">无法读取已保存的 PIN。您的钱包和原始 PIN 记录均已保留。请验证所有权以设置新的 PIN。</string>
    <string name="pin_recovery_failed">未能完成恢复，或授权已过期。保留的数据未被删除。请重试。</string>
