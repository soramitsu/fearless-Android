<?xml version="1.0" encoding="utf-8"?>
<!-- Launch window in the sun-lit palette: the page light with the winged sun at full span as the emissive sun. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android"
    android:opacity="opaque">
    <item android:drawable="@drawable/fw_page_sunlit" />
    <item
        android:width="320dp"
        android:height="320dp"
        android:gravity="center">
        <shape
            android:dither="true"
            android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="160dp"
                android:startColor="@color/fw_emissive_glow"
                android:centerColor="@color/fw_sun_bounce"
                android:endColor="@android:color/transparent" />
        </shape>
    </item>
    <item
        android:width="@dimen/fw_splash_wings_width"
        android:height="@dimen/fw_splash_wings_height"
        android:gravity="center"
        android:drawable="@drawable/fw_brand_wings" />
</layer-list>
